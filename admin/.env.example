NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side only — Settings -> API -> service_role secret. NEVER prefix
# with NEXT_PUBLIC_, never commit the real value, never import outside a
# Route Handler (see src/lib/supabaseAdmin.ts). Used to create worker Auth
# accounts (src/app/api/partners/route.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
